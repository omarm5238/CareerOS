generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions                      session[]
  accounts                      account[]
  resumeDocuments               resumeDocument[]
  jobPostings                   jobPosting[]
  skillsInsights                skillsInsight[]
  careerBriefs                  careerBrief[]
  resumeVersions                resumeVersion[]
  resumeVersionRevisions        resumeVersionRevision[]
  applications                  application[]
  applicationEvents             applicationEvent[]
  applicationContacts           applicationContact[]
  applicationInsights           applicationInsight[]
  jobDiscoveryProfile           jobDiscoveryProfile?
  jobDiscoveryRuns              jobDiscoveryRun[]
  discoveredJobs                discoveredJob[]
  applicationQueueItems         applicationQueueItem[]
  communicationDrafts           communicationDraft[]
  communicationDraftRevisions   communicationDraftRevision[]
  jobRequirements               jobRequirement[]
  jobEvidenceMatches            jobEvidenceMatch[]
  jobOpportunityAnalyses        jobOpportunityAnalysis[]
  applicationPackages           applicationPackage[]
  applicationExecutionSessions  applicationExecutionSession[]
  applicationExecutionEvents    applicationExecutionEvent[]
  applicationSubmissionAttempts applicationSubmissionAttempt[]
  applicationAnswerPreferences  applicationAnswerPreference[]
  linkedinGrowthProfiles        linkedinGrowthProfile[]
  linkedinContentPillars        linkedinContentPillar[]
  linkedinContentIdeas          linkedinContentIdea[]
  linkedinPosts                 linkedinPost[]
  linkedinPostRevisions         linkedinPostRevision[]
  linkedinPublishingPlans       linkedinPublishingPlan[]
  linkedinPostPerformances      linkedinPostPerformance[]
  linkedinGrowthInsights        linkedinGrowthInsight[]
  linkedinConnections           linkedinConnection[]
  linkedinOAuthAttempts         linkedinOAuthAttempt[]
  linkedinPublishingAttempts    linkedinPublishingAttempt[]
  dailyRoadmapPreference        dailyRoadmapPreference?
  dailyRoadmaps                 dailyRoadmap[]
  dailyRoadmapActions           dailyRoadmapAction[]
  careerActivityRecords         careerActivityRecord[]
  careerActivityDays            careerActivityDay[]
  weeklyCareerReviews           weeklyCareerReview[]
  weeklyCareerMetrics           weeklyCareerMetric[]
  weeklyCareerInsights          weeklyCareerInsight[]
  weeklyCareerRecommendations   weeklyCareerRecommendation[]
}

model session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model resumeDocument {
  id          String   @id @default(cuid())
  userId      String
  filename    String
  mimeType    String
  fileSize    Int
  textLength  Int
  textPreview String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user           user            @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis       resumeAnalysis?
  resumeVersions resumeVersion[]

  @@index([userId])
}

model resumeAnalysis {
  id                 String   @id @default(cuid())
  resumeDocumentId   String   @unique
  detectedRole       String
  experienceLevel    String
  completenessScore  Int
  detectedSkills     Json
  suggestedFocus     Json
  warnings           Json
  profileSummary     String?
  strengths          Json     @default("[]")
  weaknesses         Json     @default("[]")
  atsRecommendations Json     @default("[]")
  analysisSource     String   @default("rule_based")
  aiModel            String?
  aiWarnings         Json     @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  resumeDocument resumeDocument  @relation(fields: [resumeDocumentId], references: [id], onDelete: Cascade)
  resumeVersions resumeVersion[]
}

model jobPosting {
  id                String    @id @default(cuid())
  userId            String
  title             String
  company           String
  location          String?
  jobUrl            String?
  description       String
  source            String?
  applicationStatus String    @default("saved")
  applicationNotes  String?
  appliedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user                         user                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis                     jobAnalysis?
  resumeVersions               resumeVersion[]
  applications                 application[]
  discoveredJobs               discoveredJob[]
  communicationDrafts          communicationDraft[]
  requirements                 jobRequirement[]
  opportunityAnalysis          jobOpportunityAnalysis?
  applicationPackages          applicationPackage[]
  applicationExecutionSessions applicationExecutionSession[]

  @@index([userId])
  @@index([createdAt])
}

model jobAnalysis {
  id                  String   @id @default(cuid())
  jobPostingId        String   @unique
  matchScore          Int
  roleAlignment       String
  matchedSkills       Json
  missingSkills       Json
  resumeSignals       Json
  jobSignals          Json
  recommendations     Json
  analysisSource      String   @default("rule_based")
  aiModel             String?
  fitSummary          String?
  applicationStrategy Json     @default("[]")
  resumeTailoringTips Json     @default("[]")
  aiWarnings          Json     @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  jobPosting     jobPosting      @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  resumeVersions resumeVersion[]
}

model skillsInsight {
  id                 String   @id @default(cuid())
  userId             String
  resumeAnalysisId   String?
  jobCount           Int      @default(0)
  analysisSource     String   @default("rule_based")
  aiModel            String?
  skillCoverageScore Int      @default(0)
  prioritySkills     Json     @default("[]")
  learningRoadmap    Json     @default("[]")
  projectIdeas       Json     @default("[]")
  resumeSkillAdvice  Json     @default("[]")
  marketSignals      Json     @default("[]")
  warnings           Json     @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model careerBrief {
  id               String   @id @default(cuid())
  userId           String
  analysisSource   String   @default("rule_based")
  aiModel          String?
  healthScore      Int      @default(0)
  headline         String?
  summary          String?
  topRisks         Json     @default("[]")
  topOpportunities Json     @default("[]")
  nextActions      Json     @default("[]")
  thirtyDayPlan    Json     @default("[]")
  actionCenter     Json     @default("[]")
  warnings         Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

enum ResumeVersionType {
  JOB_SPECIFIC
  ROLE_BASED
  GENERAL
}

enum ResumeVersionStatus {
  DRAFT
  READY
  USED
  ARCHIVED
}

enum ResumeVersionRevisionSource {
  AI_GENERATED
  USER_EDITED
  RULE_BASED_FALLBACK
  IMPORTED
}

enum ResumeVersionGenerationStatus {
  PENDING
  COMPLETED
  FAILED
}

/// Container for a tailored resume version. Original uploaded resumes are never overwritten.
model resumeVersion {
  id     String @id @default(cuid())
  userId String

  sourceResumeDocumentId String?
  sourceResumeAnalysisId String?

  targetJobId         String?
  targetJobAnalysisId String?

  type   ResumeVersionType   @default(JOB_SPECIFIC)
  title  String
  status ResumeVersionStatus @default(DRAFT)

  activeRevisionId String? @unique

  alignmentScoreBefore Int?
  alignmentScoreAfter  Int?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  user                 user                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceResumeDocument resumeDocument?         @relation(fields: [sourceResumeDocumentId], references: [id], onDelete: SetNull)
  sourceResumeAnalysis resumeAnalysis?         @relation(fields: [sourceResumeAnalysisId], references: [id], onDelete: SetNull)
  targetJob            jobPosting?             @relation(fields: [targetJobId], references: [id], onDelete: SetNull)
  targetJobAnalysis    jobAnalysis?            @relation(fields: [targetJobAnalysisId], references: [id], onDelete: SetNull)
  revisions            resumeVersionRevision[] @relation("ResumeVersionRevisions")
  activeRevision       resumeVersionRevision?  @relation("ActiveResumeVersionRevision", fields: [activeRevisionId], references: [id], onDelete: SetNull)
  applications         application[]
  communicationDrafts  communicationDraft[]
  applicationPackages  applicationPackage[]

  @@index([userId])
  @@index([targetJobId])
  @@index([status])
  @@index([updatedAt])
}

/// Immutable-style content snapshot for a resume version at a specific revision point.
model resumeVersionRevision {
  id              String @id @default(cuid())
  resumeVersionId String
  userId          String

  revisionNumber      Int
  source              ResumeVersionRevisionSource
  contentJson         Json
  keywordCoverageJson Json
  warningsJson        Json
  changeLogJson       Json
  evidenceNotesJson   Json
  inputSnapshotJson   Json

  alignmentScoreBefore Int?
  alignmentScoreAfter  Int?

  model            String?
  aiSource         String?
  generationStatus ResumeVersionGenerationStatus @default(COMPLETED)
  errorMessage     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                        user                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeVersion               resumeVersion                  @relation("ResumeVersionRevisions", fields: [resumeVersionId], references: [id], onDelete: Cascade)
  activeForVersion            resumeVersion?                 @relation("ActiveResumeVersionRevision")
  applications                application[]
  communicationDrafts         communicationDraft[]
  applicationPackages         applicationPackage[]
  executionSubmissionAttempts applicationSubmissionAttempt[] @relation("AttemptResumeRevision")

  @@unique([resumeVersionId, revisionNumber])
  @@index([userId])
  @@index([resumeVersionId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Milestone 22 — Application Tracker v2
// ---------------------------------------------------------------------------

enum ApplicationStatus {
  DRAFT
  APPLIED
  SCREENING
  ASSESSMENT
  INTERVIEW
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ApplicationSource {
  JOBS_MODULE
  MANUAL
  IMPORTED
  DISCOVERY_QUEUE
}

enum ApplicationEventType {
  CREATED
  SUBMITTED
  STATUS_CHANGED
  FOLLOW_UP_SCHEDULED
  FOLLOW_UP_SENT
  FOLLOW_UP_CLEARED
  NOTE_ADDED
  CONTACT_ADDED
  CONTACT_UPDATED
  SCREENING_SCHEDULED
  SCREENING_COMPLETED
  ASSESSMENT_RECEIVED
  ASSESSMENT_SCHEDULED
  ASSESSMENT_COMPLETED
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  OFFER_RECEIVED
  REJECTION_RECORDED
  WITHDRAWN
  RESUME_LINKED
  NEXT_ACTION_UPDATED
  OTHER
}

enum ApplicationEventSource {
  USER
  SYSTEM
  AI
  IMPORTED
}

enum ApplicationInsightType {
  NEXT_ACTION
  SCREENING_PREP
  ASSESSMENT_PREP
  INTERVIEW_PREP
  OFFER_REVIEW
  REJECTION_ANALYSIS
}

enum ApplicationInsightSource {
  AI_GENERATED
  RULE_BASED_FALLBACK
}

enum ApplicationNextActionType {
  SUBMIT_APPLICATION
  FOLLOW_UP
  CONTACT_RECRUITER
  PREPARE_SCREENING
  PREPARE_ASSESSMENT
  PREPARE_INTERVIEW
  REVIEW_OFFER
  PROVIDE_DOCUMENTS
  UPDATE_RESUME
  BUILD_SKILL
  WAIT
  REVIEW_REJECTION
  OTHER
}

enum ApplicationNextActionSource {
  USER
  RULE_BASED
  AI
}

enum ApplicationRejectionSource {
  EMPLOYER_STATED
  USER_CONFIRMED_FACT
  OTHER_CONFIRMED
}

/// One real application attempt. A job may have several attempts over time.
model application {
  id     String @id @default(cuid())
  userId String

  jobPostingId String?

  status ApplicationStatus @default(DRAFT)
  source ApplicationSource @default(JOBS_MODULE)

  /// Exact resume evidence. Mutable while DRAFT, locked once APPLIED.
  resumeVersionId         String?
  resumeVersionRevisionId String?

  contextSnapshotJson Json

  appliedAt      DateTime?
  followUpAt     DateTime?
  lastActivityAt DateTime  @default(now())

  nextActionType   ApplicationNextActionType?
  nextActionTitle  String?
  nextActionReason String?
  nextActionDueAt  DateTime?
  nextActionSource ApplicationNextActionSource?

  notes        String?
  companyNotes String?
  salaryNotes  String?

  documentsNeededJson Json @default("[]")

  confirmedRejectionReason String?
  confirmedRejectionSource ApplicationRejectionSource?
  rejectedAt               DateTime?

  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                          user                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting                    jobPosting?                    @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  resumeVersion                 resumeVersion?                 @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  resumeVersionRevision         resumeVersionRevision?         @relation(fields: [resumeVersionRevisionId], references: [id], onDelete: SetNull)
  events                        applicationEvent[]
  contacts                      applicationContact[]
  insights                      applicationInsight[]
  communicationDrafts           communicationDraft[]
  applicationPackages           applicationPackage[]
  applicationExecutionSessions  applicationExecutionSession[]
  applicationSubmissionAttempts applicationSubmissionAttempt[]

  @@index([userId])
  @@index([jobPostingId])
  @@index([status])
  @@index([followUpAt])
  @@index([nextActionDueAt])
  @@index([lastActivityAt])
  @@index([updatedAt])
}

/// Append-only application timeline. Existing events are never rewritten.
model applicationEvent {
  id            String @id @default(cuid())
  applicationId String
  userId        String

  type   ApplicationEventType
  source ApplicationEventSource @default(SYSTEM)

  title       String
  description String?

  fromStatus ApplicationStatus?
  toStatus   ApplicationStatus?

  /// When the career event happened or is scheduled, not when CareerOS recorded it.
  eventAt      DateTime
  metadataJson Json     @default("{}")

  createdAt DateTime @default(now())

  user        user        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([applicationId])
  @@index([type])
  @@index([eventAt])
  @@index([applicationId, eventAt])
}

model applicationContact {
  id            String @id @default(cuid())
  applicationId String
  userId        String

  name        String
  role        String?
  company     String?
  email       String?
  phone       String?
  linkedinUrl String?
  notes       String?

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                user                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  application         application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  communicationDrafts communicationDraft[]

  @@index([userId])
  @@index([applicationId])
}

/// Persisted AI/fallback reasoning. History is retained rather than overwritten.
model applicationInsight {
  id            String @id @default(cuid())
  applicationId String
  userId        String

  type   ApplicationInsightType
  source ApplicationInsightSource @default(RULE_BASED_FALLBACK)

  contentJson         Json
  contextSnapshotJson Json
  contextFingerprint  String?

  model        String?
  aiSource     String?
  warningsJson Json    @default("[]")

  createdAt DateTime @default(now())

  user        user        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([applicationId])
  @@index([type])
  @@index([createdAt])
  @@index([applicationId, type, contextFingerprint])
}

// ---------------------------------------------------------------------------
// Milestone 23 — Job Discovery & Application Queue
// ---------------------------------------------------------------------------

enum DiscoveryRunStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum DiscoveredJobStatus {
  CANDIDATE
  FILTERED
  DISMISSED
  STALE
  EXPIRED
}

enum DiscoveryWorkMode {
  REMOTE
  HYBRID
  ONSITE
  UNKNOWN
}

enum DiscoveryEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
  OTHER
  UNKNOWN
}

enum DiscoveryProvider {
  REMOTIVE
  ARBEITNOW
  ADZUNA
  JOOBLE
}

enum DiscoveryScoreBand {
  EXCELLENT
  STRONG
  POSSIBLE
  LOW
}

enum DiscoveryAnalysisSource {
  AI_ENHANCED
  RULE_BASED
}

enum QueueStatus {
  QUEUED
  PREPARING
  HANDED_OFF
  DISMISSED
  FAILED
}

enum QueuePriority {
  HIGH
  NORMAL
  LOW
}

model jobDiscoveryProfile {
  id     String @id @default(cuid())
  userId String @unique

  roleTargetsJson      Json @default("[]")
  locationTargetsJson  Json @default("[]")
  workModesJson        Json @default("[]")
  employmentTypesJson  Json @default("[]")
  experienceLevelsJson Json @default("[]")

  includedKeywordsJson Json @default("[]")
  excludedKeywordsJson Json @default("[]")

  workAuthorizationJson Json    @default("{}")
  visaPreference        String?

  freshnessDays           Int @default(14)
  minimumSuitabilityScore Int @default(75)
  dailyTarget             Int @default(20)

  providerPreferencesJson Json @default("{}")

  applicationPreparationMode ApplicationPreparationMode @default(ASSISTED)

  generatedFromContextAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user user              @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs jobDiscoveryRun[]

  @@index([userId])
}

model jobDiscoveryRun {
  id        String  @id @default(cuid())
  userId    String
  profileId String?

  status DiscoveryRunStatus @default(RUNNING)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  querySnapshotJson  Json @default("{}")
  providerStatsJson  Json @default("[]")
  providerErrorsJson Json @default("[]")

  rawFoundCount     Int @default(0)
  normalizedCount   Int @default(0)
  duplicateCount    Int @default(0)
  hardRejectedCount Int @default(0)
  scoredCount       Int @default(0)
  strongMatchCount  Int @default(0)

  createdAt DateTime @default(now())

  user    user                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile jobDiscoveryProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model discoveredJob {
  id     String @id @default(cuid())
  userId String

  title           String
  normalizedTitle String

  company           String
  normalizedCompany String

  location    String?
  countryCode String?

  workMode       DiscoveryWorkMode       @default(UNKNOWN)
  employmentType DiscoveryEmploymentType @default(UNKNOWN)

  description String
  salaryText  String?

  postedAt  DateTime?
  expiresAt DateTime?

  canonicalFingerprint String

  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @default(now())
  timesSeen          Int      @default(1)
  lastDiscoveryRunId String?

  discoveryStatus DiscoveredJobStatus @default(CANDIDATE)

  deterministicScore Int?
  aiScore            Int?
  finalScore         Int?
  scoreBand          DiscoveryScoreBand?

  matchSummary String?

  matchedSkillsJson Json @default("[]")
  missingSkillsJson Json @default("[]")
  hardBlockersJson  Json @default("[]")
  softBlockersJson  Json @default("[]")
  evidenceJson      Json @default("[]")
  warningsJson      Json @default("[]")

  analysisSource          DiscoveryAnalysisSource?
  aiModel                 String?
  scoreContextFingerprint String?

  jobPostingId String?

  dismissedAt     DateTime?
  dismissedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       user                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting jobPosting?            @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  sources    discoveredJobSource[]
  queueItems applicationQueueItem[]

  @@unique([userId, canonicalFingerprint])
  @@index([userId])
  @@index([finalScore])
  @@index([discoveryStatus])
  @@index([lastSeenAt])
  @@index([lastDiscoveryRunId])
}

model discoveredJobSource {
  id              String @id @default(cuid())
  discoveredJobId String

  provider   DiscoveryProvider
  externalId String?

  sourceUrl String
  applyUrl  String?

  sourceMetadataJson Json @default("{}")

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  discoveredJob discoveredJob @relation(fields: [discoveredJobId], references: [id], onDelete: Cascade)

  @@unique([discoveredJobId, provider, externalId])
  @@index([discoveredJobId])
  @@index([provider])
}

model applicationQueueItem {
  id              String @id @default(cuid())
  userId          String
  discoveredJobId String

  priority    QueuePriority @default(NORMAL)
  queueStatus QueueStatus   @default(QUEUED)

  jobPostingId    String?
  resumeVersionId String?
  applicationId   String?

  preparationError        String?
  preparationSnapshotJson Json    @default("{}")

  queuedAt    DateTime  @default(now())
  preparedAt  DateTime?
  handedOffAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                user                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  discoveredJob       discoveredJob        @relation(fields: [discoveredJobId], references: [id], onDelete: Cascade)
  applicationPackages applicationPackage[]

  @@unique([userId, discoveredJobId])
  @@index([userId])
  @@index([queueStatus])
  @@index([createdAt])
}

enum CommunicationType {
  COVER_LETTER
  APPLICATION_EMAIL
  RECRUITER_OUTREACH
  FOLLOW_UP
  INTERVIEW_THANK_YOU
  POST_INTERVIEW_FOLLOW_UP
  OFFER_RESPONSE
  GENERAL_PROFESSIONAL_MESSAGE
}

enum CommunicationStatus {
  DRAFT
  READY
  USED
  ARCHIVED
}

enum CommunicationTone {
  PROFESSIONAL
  WARM
  CONCISE
  CONFIDENT
  FORMAL
}

enum CommunicationLength {
  SHORT
  STANDARD
  DETAILED
}

enum CommunicationLanguage {
  ENGLISH
  ARABIC
  TURKISH
}

enum CommunicationRevisionSource {
  AI_GENERATED
  USER_EDITED
  RULE_BASED_FALLBACK
}

enum CommunicationGenerationStatus {
  PENDING
  COMPLETED
  FAILED
}

model communicationDraft {
  id     String @id @default(cuid())
  userId String

  applicationId           String?
  jobPostingId            String?
  contactId               String?
  resumeVersionId         String?
  resumeVersionRevisionId String?

  type   CommunicationType
  status CommunicationStatus @default(DRAFT)

  activeRevisionId String? @unique

  usedAt     DateTime?
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                     user                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application              application?                 @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  jobPosting               jobPosting?                  @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  contact                  applicationContact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  resumeVersion            resumeVersion?               @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  resumeVersionRevision    resumeVersionRevision?       @relation(fields: [resumeVersionRevisionId], references: [id], onDelete: SetNull)
  revisions                communicationDraftRevision[] @relation("CommunicationDraftRevisions")
  activeRevision           communicationDraftRevision?  @relation("ActiveCommunicationDraftRevision", fields: [activeRevisionId], references: [id], onDelete: SetNull)
  coverLetterPackages      applicationPackage[]         @relation("PackageCoverLetter")
  applicationEmailPackages applicationPackage[]         @relation("PackageApplicationEmail")

  @@index([userId])
  @@index([applicationId])
  @@index([jobPostingId])
  @@index([contactId])
  @@index([type])
  @@index([status])
  @@index([updatedAt])
}

model communicationDraftRevision {
  id                   String @id @default(cuid())
  communicationDraftId String
  userId               String

  revisionNumber Int
  source         CommunicationRevisionSource

  subject String?
  content String

  tone     CommunicationTone
  length   CommunicationLength
  language CommunicationLanguage

  contextSnapshotJson Json
  contextFingerprint  String

  evidenceUsedJson Json @default("[]")
  warningsJson     Json @default("[]")
  changeLogJson    Json @default("[]")

  model            String?
  aiSource         String?
  generationStatus CommunicationGenerationStatus @default(COMPLETED)
  errorMessage     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                         user                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  communicationDraft           communicationDraft             @relation("CommunicationDraftRevisions", fields: [communicationDraftId], references: [id], onDelete: Cascade)
  activeForDraft               communicationDraft?            @relation("ActiveCommunicationDraftRevision")
  executionCoverLetterAttempts applicationSubmissionAttempt[] @relation("AttemptCoverLetterRevision")
  approvedCoverLetterPackages  applicationPackage[]           @relation("PackageCoverLetterRevision")

  @@unique([communicationDraftId, revisionNumber])
  @@index([userId])
  @@index([communicationDraftId])
  @@index([createdAt])
}

