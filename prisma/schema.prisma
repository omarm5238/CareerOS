generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions               session[]
  accounts               account[]
  resumeDocuments        resumeDocument[]
  jobPostings            jobPosting[]
  skillsInsights         skillsInsight[]
  careerBriefs           careerBrief[]
  resumeVersions         resumeVersion[]
  resumeVersionRevisions resumeVersionRevision[]
  applications           application[]
  applicationEvents      applicationEvent[]
  applicationContacts    applicationContact[]
  applicationInsights    applicationInsight[]
}

model session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model resumeDocument {
  id          String   @id @default(cuid())
  userId      String
  filename    String
  mimeType    String
  fileSize    Int
  textLength  Int
  textPreview String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user           user            @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis       resumeAnalysis?
  resumeVersions resumeVersion[]

  @@index([userId])
}

model resumeAnalysis {
  id                 String   @id @default(cuid())
  resumeDocumentId   String   @unique
  detectedRole       String
  experienceLevel    String
  completenessScore  Int
  detectedSkills     Json
  suggestedFocus     Json
  warnings           Json
  profileSummary     String?
  strengths          Json     @default("[]")
  weaknesses         Json     @default("[]")
  atsRecommendations Json     @default("[]")
  analysisSource     String   @default("rule_based")
  aiModel            String?
  aiWarnings         Json     @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  resumeDocument resumeDocument  @relation(fields: [resumeDocumentId], references: [id], onDelete: Cascade)
  resumeVersions resumeVersion[]
}

model jobPosting {
  id                String    @id @default(cuid())
  userId            String
  title             String
  company           String
  location          String?
  jobUrl            String?
  description       String
  source            String?
  applicationStatus String    @default("saved")
  applicationNotes  String?
  appliedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user           user            @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis       jobAnalysis?
  resumeVersions resumeVersion[]
  applications   application[]

  @@index([userId])
  @@index([createdAt])
}

model jobAnalysis {
  id                  String   @id @default(cuid())
  jobPostingId        String   @unique
  matchScore          Int
  roleAlignment       String
  matchedSkills       Json
  missingSkills       Json
  resumeSignals       Json
  jobSignals          Json
  recommendations     Json
  analysisSource      String   @default("rule_based")
  aiModel             String?
  fitSummary          String?
  applicationStrategy Json     @default("[]")
  resumeTailoringTips Json     @default("[]")
  aiWarnings          Json     @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  jobPosting     jobPosting      @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  resumeVersions resumeVersion[]
}

model skillsInsight {
  id                 String   @id @default(cuid())
  userId             String
  resumeAnalysisId   String?
  jobCount           Int      @default(0)
  analysisSource     String   @default("rule_based")
  aiModel            String?
  skillCoverageScore Int      @default(0)
  prioritySkills     Json     @default("[]")
  learningRoadmap    Json     @default("[]")
  projectIdeas       Json     @default("[]")
  resumeSkillAdvice  Json     @default("[]")
  marketSignals      Json     @default("[]")
  warnings           Json     @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model careerBrief {
  id               String   @id @default(cuid())
  userId           String
  analysisSource   String   @default("rule_based")
  aiModel          String?
  healthScore      Int      @default(0)
  headline         String?
  summary          String?
  topRisks         Json     @default("[]")
  topOpportunities Json     @default("[]")
  nextActions      Json     @default("[]")
  thirtyDayPlan    Json     @default("[]")
  actionCenter     Json     @default("[]")
  warnings         Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

enum ResumeVersionType {
  JOB_SPECIFIC
  ROLE_BASED
  GENERAL
}

enum ResumeVersionStatus {
  DRAFT
  READY
  USED
  ARCHIVED
}

enum ResumeVersionRevisionSource {
  AI_GENERATED
  USER_EDITED
  RULE_BASED_FALLBACK
  IMPORTED
}

enum ResumeVersionGenerationStatus {
  PENDING
  COMPLETED
  FAILED
}

/// Container for a tailored resume version. Original uploaded resumes are never overwritten.
model resumeVersion {
  id     String @id @default(cuid())
  userId String

  sourceResumeDocumentId String?
  sourceResumeAnalysisId String?

  targetJobId         String?
  targetJobAnalysisId String?

  type   ResumeVersionType   @default(JOB_SPECIFIC)
  title  String
  status ResumeVersionStatus @default(DRAFT)

  activeRevisionId String? @unique

  alignmentScoreBefore Int?
  alignmentScoreAfter  Int?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  user                 user                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceResumeDocument resumeDocument?         @relation(fields: [sourceResumeDocumentId], references: [id], onDelete: SetNull)
  sourceResumeAnalysis resumeAnalysis?         @relation(fields: [sourceResumeAnalysisId], references: [id], onDelete: SetNull)
  targetJob            jobPosting?             @relation(fields: [targetJobId], references: [id], onDelete: SetNull)
  targetJobAnalysis    jobAnalysis?            @relation(fields: [targetJobAnalysisId], references: [id], onDelete: SetNull)
  revisions            resumeVersionRevision[] @relation("ResumeVersionRevisions")
  activeRevision       resumeVersionRevision?  @relation("ActiveResumeVersionRevision", fields: [activeRevisionId], references: [id], onDelete: SetNull)
  applications         application[]

  @@index([userId])
  @@index([targetJobId])
  @@index([status])
  @@index([updatedAt])
}

/// Immutable-style content snapshot for a resume version at a specific revision point.
model resumeVersionRevision {
  id              String @id @default(cuid())
  resumeVersionId String
  userId          String

  revisionNumber      Int
  source              ResumeVersionRevisionSource
  contentJson         Json
  keywordCoverageJson Json
  warningsJson        Json
  changeLogJson       Json
  evidenceNotesJson   Json
  inputSnapshotJson   Json

  alignmentScoreBefore Int?
  alignmentScoreAfter  Int?

  model            String?
  aiSource         String?
  generationStatus ResumeVersionGenerationStatus @default(COMPLETED)
  errorMessage     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             user           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeVersion    resumeVersion  @relation("ResumeVersionRevisions", fields: [resumeVersionId], references: [id], onDelete: Cascade)
  activeForVersion resumeVersion? @relation("ActiveResumeVersionRevision")
  applications     application[]

  @@unique([resumeVersionId, revisionNumber])
  @@index([userId])
  @@index([resumeVersionId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Milestone 22 — Application Tracker v2
// ---------------------------------------------------------------------------

enum ApplicationStatus {
  DRAFT
  APPLIED
  SCREENING
  ASSESSMENT
  INTERVIEW
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ApplicationSource {
  JOBS_MODULE
  MANUAL
  IMPORTED
  DISCOVERY_QUEUE
}

enum ApplicationEventType {
  CREATED
  SUBMITTED
  STATUS_CHANGED
  FOLLOW_UP_SCHEDULED
  FOLLOW_UP_SENT
  FOLLOW_UP_CLEARED
  NOTE_ADDED
  CONTACT_ADDED
  CONTACT_UPDATED
  SCREENING_SCHEDULED
  SCREENING_COMPLETED
  ASSESSMENT_RECEIVED
  ASSESSMENT_SCHEDULED
  ASSESSMENT_COMPLETED
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  OFFER_RECEIVED
  REJECTION_RECORDED
  WITHDRAWN
  RESUME_LINKED
  NEXT_ACTION_UPDATED
  OTHER
}

enum ApplicationEventSource {
  USER
  SYSTEM
  AI
  IMPORTED
}

enum ApplicationInsightType {
  NEXT_ACTION
  SCREENING_PREP
  ASSESSMENT_PREP
  INTERVIEW_PREP
  OFFER_REVIEW
  REJECTION_ANALYSIS
}

enum ApplicationInsightSource {
  AI_GENERATED
  RULE_BASED_FALLBACK
}

enum ApplicationNextActionType {
  SUBMIT_APPLICATION
  FOLLOW_UP
  CONTACT_RECRUITER
  PREPARE_SCREENING
  PREPARE_ASSESSMENT
  PREPARE_INTERVIEW
  REVIEW_OFFER
  PROVIDE_DOCUMENTS
  UPDATE_RESUME
  BUILD_SKILL
  WAIT
  REVIEW_REJECTION
  OTHER
}

enum ApplicationNextActionSource {
  USER
  RULE_BASED
  AI
}

enum ApplicationRejectionSource {
  EMPLOYER_STATED
  USER_CONFIRMED_FACT
  OTHER_CONFIRMED
}

/// One real application attempt. A job may have several attempts over time.
model application {
  id     String @id @default(cuid())
  userId String

  jobPostingId String?

  status ApplicationStatus @default(DRAFT)
  source ApplicationSource @default(JOBS_MODULE)

  /// Exact resume evidence. Mutable while DRAFT, locked once APPLIED.
  resumeVersionId         String?
  resumeVersionRevisionId String?

  contextSnapshotJson Json

  appliedAt      DateTime?
  followUpAt     DateTime?
  lastActivityAt DateTime  @default(now())

  nextActionType   ApplicationNextActionType?
  nextActionTitle  String?
  nextActionReason String?
  nextActionDueAt  DateTime?
  nextActionSource ApplicationNextActionSource?

  notes        String?
  companyNotes String?
  salaryNotes  String?

  documentsNeededJson Json @default("[]")

  confirmedRejectionReason String?
  confirmedRejectionSource ApplicationRejectionSource?
  rejectedAt               DateTime?

  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                  user                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting            jobPosting?            @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  resumeVersion         resumeVersion?         @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  resumeVersionRevision resumeVersionRevision? @relation(fields: [resumeVersionRevisionId], references: [id], onDelete: SetNull)
  events                applicationEvent[]
  contacts              applicationContact[]
  insights              applicationInsight[]

  @@index([userId])
  @@index([jobPostingId])
  @@index([status])
  @@index([followUpAt])
  @@index([nextActionDueAt])
  @@index([lastActivityAt])
  @@index([updatedAt])
}

/// Append-only application timeline. Existing events are never rewritten.
model applicationEvent {
  id            String @id @default(cuid())
  applicationId String
  userId        String

  type   ApplicationEventType
  source ApplicationEventSource @default(SYSTEM)

  title       String
  description String?

  fromStatus ApplicationStatus?
  toStatus   ApplicationStatus?

  /// When the career event happened or is scheduled, not when CareerOS recorded it.
  eventAt      DateTime
  metadataJson Json     @default("{}")

  createdAt DateTime @default(now())

  user        user        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([applicationId])
  @@index([type])
  @@index([eventAt])
  @@index([applicationId, eventAt])
}

model applicationContact {
  id            String @id @default(cuid())
  applicationId String
  userId        String

  name        String
  role        String?
  company     String?
  email       String?
  phone       String?
  linkedinUrl String?
  notes       String?

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        user        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([applicationId])
}

/// Persisted AI/fallback reasoning. History is retained rather than overwritten.
model applicationInsight {
  id            String @id @default(cuid())
  applicationId String
  userId        String

  type   ApplicationInsightType
  source ApplicationInsightSource @default(RULE_BASED_FALLBACK)

  contentJson         Json
  contextSnapshotJson Json
  contextFingerprint  String?

  model        String?
  aiSource     String?
  warningsJson Json    @default("[]")

  createdAt DateTime @default(now())

  user        user        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([applicationId])
  @@index([type])
  @@index([createdAt])
  @@index([applicationId, type, contextFingerprint])
}
