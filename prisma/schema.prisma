model applicationExecutionSession {
  id     String @id @default(cuid())
  userId String

  applicationPackageId String
  applicationId        String
  jobPostingId         String

  provider       ApplicationProvider      @default(UNKNOWN)
  adapterVersion String                   @default("1.0.0")
  executionMode  ApplicationExecutionMode @default(ASSISTED_BROWSER)

  status ApplicationExecutionStatus @default(CREATED)

  currentUrl  String?
  currentStep Int?
  totalSteps  Int?

  formFingerprint String?

  formSnapshotJson   Json @default("{}")
  fillPlanJson       Json @default("{}")
  pendingActionsJson Json @default("[]")
  warningsJson       Json @default("[]")

  failureCode    ApplicationExecutionFailureCode?
  failureMessage String?

  startedAt      DateTime?
  lastActivityAt DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               user                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationPackage applicationPackage             @relation(fields: [applicationPackageId], references: [id], onDelete: Cascade)
  application        application                    @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  jobPosting         jobPosting                     @relation(fields: [jobPostingId], references: [id], onDelete: Restrict)
  events             applicationExecutionEvent[]
  submissionAttempts applicationSubmissionAttempt[]

  @@index([userId])
  @@index([applicationPackageId])
  @@index([applicationId])
  @@index([jobPostingId])
  @@index([status])
  @@index([updatedAt])
}

model applicationExecutionEvent {
  id                 String @id @default(cuid())
  userId             String
  executionSessionId String

  type         ApplicationExecutionEventType
  message      String
  metadataJson Json                          @default("{}")

  createdAt DateTime @default(now())

  user             user                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  executionSession applicationExecutionSession @relation(fields: [executionSessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([executionSessionId])
  @@index([createdAt])
  @@index([executionSessionId, createdAt])
}

model applicationSubmissionAttempt {
  id     String @id @default(cuid())
  userId String

  executionSessionId   String
  applicationPackageId String
  applicationId        String

  attemptNumber Int

  method             ApplicationSubmissionMethod
  status             ApplicationSubmissionAttemptStatus      @default(APPROVAL_GRANTED)
  verificationStatus ApplicationSubmissionVerificationStatus @default(NOT_RUN)

  approvalFingerprint String
  approvalTokenHash   String?
  approvalExpiresAt   DateTime?
  approvalUsedAt      DateTime?

  finalSubmissionSnapshotJson Json @default("{}")

  providerApplicationId String?
  confirmationUrl       String?

  verificationEvidenceJson Json @default("{}")

  failureCode    ApplicationExecutionFailureCode?
  failureMessage String?

  resumeVersionRevisionId String
  resumeFileHash          String

  coverLetterRevisionId String?
  coverLetterFileHash   String?

  startedAt   DateTime?
  submittedAt DateTime?
  verifiedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                  user                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  executionSession      applicationExecutionSession @relation(fields: [executionSessionId], references: [id], onDelete: Cascade)
  applicationPackage    applicationPackage          @relation(fields: [applicationPackageId], references: [id], onDelete: Cascade)
  application           application                 @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  resumeVersionRevision resumeVersionRevision       @relation("AttemptResumeRevision", fields: [resumeVersionRevisionId], references: [id], onDelete: Restrict)
  coverLetterRevision   communicationDraftRevision? @relation("AttemptCoverLetterRevision", fields: [coverLetterRevisionId], references: [id], onDelete: Restrict)

  @@unique([executionSessionId, attemptNumber])
  @@index([userId])
  @@index([applicationPackageId])
  @@index([applicationId])
  @@index([status])
  @@index([createdAt])
}

model applicationAnswerPreference {
  id     String @id @default(cuid())
  userId String

  key      String
  category String

  scopeType  ApplicationAnswerScope
  scopeValue String                 @default("")

  valueJson Json

  requiresPerApplicationConfirmation Boolean @default(false)

  confirmedAt DateTime
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key, scopeType, scopeValue])
  @@index([userId])
  @@index([key])
  @@index([expiresAt])
}
