model jobRequirement {
  id     String @id @default(cuid())
  userId String

  jobPostingId String

  category       JobRequirementCategory
  importance     JobRequirementImportance
  normalizedName String
  rawText        String
  sourceExcerpt  String

  yearsRequired       Int?
  proficiencyRequired String?

  isExplicit  Boolean
  fingerprint String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            user               @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting      jobPosting         @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  evidenceMatches jobEvidenceMatch[]

  @@unique([jobPostingId, fingerprint])
  @@index([userId])
  @@index([jobPostingId])
  @@index([category])
  @@index([importance])
}

model jobEvidenceMatch {
  id     String @id @default(cuid())
  userId String

  jobRequirementId String

  evidenceType     JobEvidenceType
  evidenceSourceId String?
  evidenceLabel    String
  evidenceExcerpt  String?
  matchStrength    JobEvidenceMatchStrength
  reasoning        String?

  fingerprint String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           user           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobRequirement jobRequirement @relation(fields: [jobRequirementId], references: [id], onDelete: Cascade)

  @@unique([jobRequirementId, fingerprint])
  @@index([userId])
  @@index([jobRequirementId])
  @@index([matchStrength])
}

model jobOpportunityAnalysis {
  id     String @id @default(cuid())
  userId String

  jobPostingId String @unique

  status JobOpportunityAnalysisStatus @default(PENDING)

  roleFit                Int
  skillFit               Int
  experienceFit          Int
  evidenceFit            Int
  locationFit            Int
  authorizationFit       Int
  freshnessScore         Int
  applicationEffortScore Int

  opportunityScore Int
  priorityScore    Int

  priorityBand   OpportunityPriorityBand
  recommendation OpportunityRecommendation

  eligibilityStatus JobEligibilityStatus
  applicationEffort ApplicationEffort

  evidenceCoverage Int

  criticalGapCount  Int @default(0)
  importantGapCount Int @default(0)
  minorGapCount     Int @default(0)
  optionalGapCount  Int @default(0)

  gapsJson              Json @default("[]")
  eligibilityChecksJson Json @default("[]")
  warningsJson          Json @default("[]")

  summary String?

  contextFingerprint String
  analysisSource     JobOpportunityAnalysisSource

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       user       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting jobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@unique([userId, jobPostingId])
  @@index([userId])
  @@index([jobPostingId])
  @@index([priorityBand])
  @@index([opportunityScore])
  @@index([priorityScore])
  @@index([eligibilityStatus])
  @@index([updatedAt])
}

model applicationPackage {
  id     String @id @default(cuid())
  userId String

  jobPostingId           String?
  applicationQueueItemId String?
  applicationId          String?

  version Int @default(1)

  resumeVersionId         String?
  resumeVersionRevisionId String?

  coverLetterDraftId      String?
  coverLetterRevisionId   String?
  applicationEmailDraftId String?

  status          ApplicationPackageStatus   @default(PREPARING)
  readinessStatus ApplicationReadinessStatus @default(NEEDS_REVIEW)
  qaStatus        ApplicationPackageQaStatus @default(NOT_RUN)

  opportunitySnapshotJson Json @default("{}")
  evidenceSnapshotJson    Json @default("[]")
  gapSnapshotJson         Json @default("[]")
  eligibilitySnapshotJson Json @default("[]")
  requiredUserInputsJson  Json @default("[]")
  qaSnapshotJson          Json @default("{}")
  warningsJson            Json @default("[]")

  contextFingerprint String

  preparedAt          DateTime?
  approvedAt          DateTime?
  submissionStartedAt DateTime?
  submittedAt         DateTime?
  archivedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                  user                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting            jobPosting?                    @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  applicationQueueItem  applicationQueueItem?          @relation(fields: [applicationQueueItemId], references: [id], onDelete: SetNull)
  application           application?                   @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  resumeVersion         resumeVersion?                 @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  resumeVersionRevision resumeVersionRevision?         @relation(fields: [resumeVersionRevisionId], references: [id], onDelete: SetNull)
  coverLetterDraft      communicationDraft?            @relation("PackageCoverLetter", fields: [coverLetterDraftId], references: [id], onDelete: SetNull)
  coverLetterRevision   communicationDraftRevision?    @relation("PackageCoverLetterRevision", fields: [coverLetterRevisionId], references: [id], onDelete: SetNull)
  applicationEmailDraft communicationDraft?            @relation("PackageApplicationEmail", fields: [applicationEmailDraftId], references: [id], onDelete: SetNull)
  executionSessions     applicationExecutionSession[]
  submissionAttempts    applicationSubmissionAttempt[]

  @@unique([userId, jobPostingId, version])
  @@index([userId])
  @@index([jobPostingId])
  @@index([applicationId])
  @@index([status])
  @@index([readinessStatus])
  @@index([qaStatus])
  @@index([updatedAt])
}

