  capturedAt DateTime

  impressions        Int?
  views              Int?
  likes              Int?
  comments           Int?
  reposts            Int?
  saves              Int?
  profileViews       Int?
  newFollowers       Int?
  connectionRequests Int?
  recruiterMessages  Int?

  source LinkedinPerformanceSource @default(USER_ENTERED)
  notes  String?

  createdAt DateTime @default(now())

  user         user         @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedinPost linkedinPost @relation(fields: [linkedinPostId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([linkedinPostId])
  @@index([capturedAt])
}

model linkedinGrowthInsight {
  id                      String @id @default(cuid())
  userId                  String
  linkedinGrowthProfileId String

  type    LinkedinGrowthInsightType
  title   String
  summary String

  evidenceJson Json                        @default("{}")
  confidence   String
  status       LinkedinGrowthInsightStatus @default(ACTIVE)

  createdAt   DateTime  @default(now())
  dismissedAt DateTime?

  user          user                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  growthProfile linkedinGrowthProfile @relation(fields: [linkedinGrowthProfileId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([linkedinGrowthProfileId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Milestone 25B — Official LinkedIn Connection + Verified Publishing
// ---------------------------------------------------------------------------

enum LinkedinConnectionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  REAUTH_REQUIRED
  CONNECTION_ERROR
  DISCONNECTING
}

enum LinkedinPublishingAttemptStatus {
  CREATED
  VALIDATING
  READY_TO_PUBLISH
  SUBMITTING
  VERIFYING
  PUBLISHED
  FAILED
  UNCERTAIN
  CANCELLED
}

model linkedinConnection {
  id     String @id @default(cuid())
  userId String

  providerSubject String?
  displayName     String?
  email           String?
  profileImageUrl String?

  status LinkedinConnectionStatus @default(DISCONNECTED)

  encryptedAccessToken String?
  tokenExpiresAt       DateTime?

  grantedScopesJson      Json  @default("[]")
  capabilitySnapshotJson Json?

  connectedAt      DateTime?
  lastValidatedAt  DateTime?
  reauthRequiredAt DateTime?
  disconnectedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               user                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishingAttempts linkedinPublishingAttempt[]

  @@unique([userId])
  @@index([status])
  @@index([providerSubject])
}

model linkedinOAuthAttempt {
  id     String @id @default(cuid())
  userId String

  stateHash             String    @unique
  redirectUri           String
  pkceVerifierEncrypted String?
  expiresAt             DateTime
  usedAt                DateTime?

  createdAt DateTime @default(now())

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model linkedinPublishingAttempt {
  id     String @id @default(cuid())
  userId String

  linkedinConnectionId     String?
  linkedinPublishingPlanId String
  linkedinPostId           String
  linkedinPostRevisionId   String

  status LinkedinPublishingAttemptStatus @default(CREATED)

  contentFingerprint     String
  capabilitySnapshotJson Json?

  providerRequestId      String?
  externalLinkedInPostId String?
  externalLinkedInUrl    String?

  errorCode         String?
  providerErrorJson Json?

  createdAt   DateTime  @default(now())
  validatedAt DateTime?
  submittedAt DateTime?
  verifiedAt  DateTime?
  failedAt    DateTime?
  resolvedAt  DateTime?

  updatedAt DateTime @updatedAt

  user                   user                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedinConnection     linkedinConnection?    @relation(fields: [linkedinConnectionId], references: [id], onDelete: SetNull)
  linkedinPublishingPlan linkedinPublishingPlan @relation(fields: [linkedinPublishingPlanId], references: [id], onDelete: Cascade)
  linkedinPost           linkedinPost           @relation(fields: [linkedinPostId], references: [id], onDelete: Cascade)
  linkedinPostRevision   linkedinPostRevision   @relation(fields: [linkedinPostRevisionId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([linkedinPublishingPlanId, status])
  @@index([linkedinPostId])
  @@index([linkedinPostRevisionId])
  @@index([linkedinConnectionId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Milestone 26 — Daily Roadmap + Career Streak
// ---------------------------------------------------------------------------

enum DailyRoadmapStatus {
  ACTIVE
  CLOSED
}

enum DailyRoadmapGenerationSource {
  DETERMINISTIC
  AI_ASSISTED
  FALLBACK
}

enum DailyRoadmapActionType {
  JOB_REVIEW
  JOB_PREPARE
  JOB_APPLY
  APPLICATION_FOLLOW_UP
  APPLICATION_NEXT_STEP
  INTERVIEW_PREP
  ASSESSMENT_PREP
  RESUME_REVIEW
  COMMUNICATION_REVIEW
  LINKEDIN_POST_REVIEW
  LINKEDIN_PUBLISH
  LINKEDIN_ANALYTICS_REVIEW
  LINKEDIN_RECONNECT
  SKILL_DEVELOPMENT
  EVIDENCE_BUILDING
  PROFILE_IMPROVEMENT
  WEEKLY_PREP
  CUSTOM_CAREER_ACTION
}

enum DailyRoadmapActionOrigin {
  SYSTEM_GENERATED
  USER_CREATED
  SYSTEM_RECOMMENDED
  CARRIED_OVER
}

enum DailyRoadmapSourceEntityType {
  JOB
  APPLICATION
  RESUME_VERSION
  COMMUNICATION
  LINKEDIN_POST
  LINKEDIN_PLAN
  SKILL
  PROJECT
  CAREER_CONTEXT
  NONE
}

enum DailyRoadmapActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  DEFERRED
  EXPIRED
  BLOCKED
}

enum DailyRoadmapCompletionSource {
  USER_CONFIRMED
  DOMAIN_EVENT
  SYSTEM_RECONCILED
}

enum DailyRoadmapPriorityBand {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum CareerActivityType {
  APPLICATION_SUBMITTED
  RESUME_READY
  COMMUNICATION_USED
  LINKEDIN_PUBLISHED
  ROADMAP_ACTION_COMPLETED
  SKILL_ACTION_COMPLETED
  EVIDENCE_ACTION_COMPLETED
  INTERVIEW_PREP_COMPLETED
  ASSESSMENT_PREP_COMPLETED
}

model dailyRoadmapPreference {
  id     String @id @default(cuid())
  userId String @unique

  timezone           String @default("UTC")
  dailyMinutesTarget Int    @default(60)
  maxCoreActions     Int    @default(4)
  activeWeekdaysJson Json   @default("[\"MON\",\"TUE\",\"WED\",\"THU\",\"FRI\"]")

  includeLinkedIn         Boolean @default(true)
  includeSkillDevelopment Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model dailyRoadmap {
  id     String @id @default(cuid())
  userId String

  /// User-local career day as YYYY-MM-DD. Never rewritten after creation.
  localDate String
  timezone  String

  status DailyRoadmapStatus @default(ACTIVE)

  generatedAt DateTime  @default(now())
  refreshedAt DateTime?

  plannedMinutes     Int
  contextFingerprint String
  generationSource   DailyRoadmapGenerationSource @default(DETERMINISTIC)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    user                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  actions dailyRoadmapAction[]

  @@unique([userId, localDate])
  @@index([userId])
  @@index([localDate])
  @@index([status])
}

model dailyRoadmapAction {
  id             String @id @default(cuid())
  userId         String
  dailyRoadmapId String

  type   DailyRoadmapActionType
  origin DailyRoadmapActionOrigin

  sourceEntityType DailyRoadmapSourceEntityType
  sourceEntityId   String?

  title   String
  summary String?
  whyNow  String?

  priorityScore Int
  priorityBand  DailyRoadmapPriorityBand

  estimatedMinutes Int

  status DailyRoadmapActionStatus @default(PLANNED)

  isMeaningful  Boolean @default(false)
  isActionable  Boolean @default(true)
  blockedReason String?

  sortOrder Int

  deferredUntil    String?
  completedAt      DateTime?
  completionSource DailyRoadmapCompletionSource?

  deepLink String?

  contextSnapshotJson Json   @default("{}")
  fingerprint         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         user         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyRoadmap dailyRoadmap @relation(fields: [dailyRoadmapId], references: [id], onDelete: Cascade)

  @@unique([dailyRoadmapId, fingerprint])
  @@index([userId])
  @@index([dailyRoadmapId])
  @@index([status])
  @@index([type])
  @@index([sourceEntityType, sourceEntityId])
}

model careerActivityRecord {
  id     String @id @default(cuid())
  userId String

  localDate String
  timezone  String

  activityType CareerActivityType

  sourceEntityType DailyRoadmapSourceEntityType
  sourceEntityId   String?

  meaningful Boolean @default(true)
  minutes    Int?

  occurredAt  DateTime
  fingerprint String

  createdAt DateTime @default(now())

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId])
  @@index([localDate])
  @@index([activityType])
  @@index([occurredAt])
}

model careerActivityDay {
  id     String @id @default(cuid())
  userId String

  localDate String
  timezone  String

  meaningfulActionCount Int  @default(0)
  completedActionCount  Int  @default(0)
  plannedActionCount    Int  @default(0)
  completedMinutes      Int?

  qualifiesForStreak Boolean @default(false)

  firstMeaningfulActivityAt DateTime?
  lastMeaningfulActivityAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate])
  @@index([userId])
  @@index([localDate])
  @@index([qualifiesForStreak])
}

enum WeeklyCareerReviewStatus {
  DRAFT
  FINALIZED
}

enum WeeklyCareerGenerationSource {
  DETERMINISTIC
  AI_ASSISTED
  FALLBACK
}

enum WeeklyCareerMomentumBand {
  STRONG
  STEADY
  MIXED
  LOW
}

enum WeeklyCareerMetricCategory {
  EXECUTION
  OPPORTUNITIES
  APPLICATIONS
  FOLLOW_UP
  RESUME
  COMMUNICATION
  LINKEDIN
  SKILLS_EVIDENCE
}

enum WeeklyCareerMetricApplicability {
  DATA_AVAILABLE
  NO_ACTIVITY
  NOT_APPLICABLE
}

enum WeeklyCareerMetricSourceSubsystem {
  M21_RESUME
  M22_APPLICATION
  M23_JOBS
  M24_COMMUNICATION
  M25_LINKEDIN
  M26_DAILY
}

enum WeeklyCareerInsightType {
  PROGRESS_PATTERN
  STALL_PATTERN
  CONSISTENCY_PATTERN
  OPPORTUNITY_GAP
  FOLLOW_UP_GAP
  EXECUTION_GAP
  VISIBILITY_GAP
  EVIDENCE_GAP
  APPLICATION_FUNNEL_PATTERN
  NEXT_WEEK_FOCUS
}

enum WeeklyCareerInsightConfidence {
  LOW
  MEDIUM
  HIGH
}

enum WeeklyCareerInsightSeverity {
  INFO
  ATTENTION
}

enum WeeklyCareerRecommendationStatus {
  OPEN
  ADOPTED
  DISMISSED
}

enum WeeklyCareerRecommendationPriority {
  HIGH
  MEDIUM
  LOW
}

model weeklyCareerReview {
  id     String @id @default(cuid())
  userId String

  weekStartLocalDate String
  weekEndLocalDate   String
  timezone           String

  status WeeklyCareerReviewStatus @default(DRAFT)

  generatedAt DateTime  @default(now())
  refreshedAt DateTime?
  finalizedAt DateTime?

  contextFingerprint String
  generationSource   WeeklyCareerGenerationSource @default(DETERMINISTIC)

  overallMomentumScore Int?
  overallMomentumBand  WeeklyCareerMomentumBand?

  summary         String?
  winsSummary     String?
  frictionSummary String?

  componentsJson  Json @default("{}")
  comparisonJson  Json @default("{}")
  winsJson        Json @default("[]")
  frictionJson    Json @default("[]")
  limitationsJson Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            user                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics         weeklyCareerMetric[]
  insights        weeklyCareerInsight[]
  recommendations weeklyCareerRecommendation[]

  @@unique([userId, weekStartLocalDate])
  @@index([userId])
  @@index([weekStartLocalDate])
  @@index([status])
}

model weeklyCareerMetric {
  id                   String @id @default(cuid())
  userId               String
  weeklyCareerReviewId String

  category  WeeklyCareerMetricCategory
  metricKey String

  numericValue     Float?
  textValue        String?
  denominatorValue Float?

  applicability   WeeklyCareerMetricApplicability
  sourceSubsystem WeeklyCareerMetricSourceSubsystem
  evidenceJson    Json                              @default("{}")

  createdAt DateTime @default(now())

  user   user               @relation(fields: [userId], references: [id], onDelete: Cascade)
  review weeklyCareerReview @relation(fields: [weeklyCareerReviewId], references: [id], onDelete: Cascade)

  @@unique([weeklyCareerReviewId, metricKey])
  @@index([userId])
  @@index([weeklyCareerReviewId])
  @@index([category])
}

model weeklyCareerInsight {
  id                   String @id @default(cuid())
  userId               String
  weeklyCareerReviewId String

  type     WeeklyCareerInsightType
  category WeeklyCareerMetricCategory

  title   String
  summary String

  evidenceJson Json                          @default("{}")
  confidence   WeeklyCareerInsightConfidence
  severity     WeeklyCareerInsightSeverity

  fingerprint String

  createdAt DateTime @default(now())

  user   user               @relation(fields: [userId], references: [id], onDelete: Cascade)
  review weeklyCareerReview @relation(fields: [weeklyCareerReviewId], references: [id], onDelete: Cascade)

  @@unique([weeklyCareerReviewId, fingerprint])
  @@index([userId])
  @@index([weeklyCareerReviewId])
  @@index([type])
}

model weeklyCareerRecommendation {
  id                   String @id @default(cuid())
  userId               String
  weeklyCareerReviewId String

  category WeeklyCareerMetricCategory

  title    String
  reason   String
  priority WeeklyCareerRecommendationPriority

  sourceEvidenceJson Json @default("{}")

  recommendedActionType String?
  deepLink              String?

  status    WeeklyCareerRecommendationStatus @default(OPEN)
  adoptedAt DateTime?

  fingerprint String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   user               @relation(fields: [userId], references: [id], onDelete: Cascade)
  review weeklyCareerReview @relation(fields: [weeklyCareerReviewId], references: [id], onDelete: Cascade)

  @@unique([weeklyCareerReviewId, fingerprint])
  @@index([userId])
  @@index([weeklyCareerReviewId])
  @@index([status])
}
